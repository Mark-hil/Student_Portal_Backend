# ── Django Settings ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-change-in-production-min-50-chars
ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1
CORS_ORIGINS=https://portal.yourdomain.com,http://localhost:5173

# ── Neon / PostgreSQL Database ────────────────────────────────────────────────
# Option A (Recommended for Neon): Direct or pooled connection URL from Neon dashboard
DATABASE_URL=postgresql://neondb_owner:your-password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Discrete connection variables (fallback if DATABASE_URL is not set)
# DB_HOST=ep-xyz.us-east-2.aws.neon.tech
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=your-database-password
# DB_PORT=5432
# DB_CONN_MAX_AGE=600

# Optional: Neon Read Replica (if configured, otherwise default DB is mirrored)
# DATABASE_REPLICA_URL=postgresql://neondb_owner:your-password@ep-xyz-readreplica.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Cloudinary Media Storage ──────────────────────────────────────────────────
# Used for user avatars, student document uploads, and course file attachments
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_PROFILE_FOLDER=uniportal-profile picture

# ── Redis (Celery background tasks & caching) ──────────────────────────────────
REDIS_URL=redis://:your-redis-password@redis:6379/0
REDIS_PASSWORD=your-redis-password

# ── Email (SendGrid / SMTP) ────────────────────────────────────────────────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@youruniversity.edu

# ── Monitoring (Sentry) ───────────────────────────────────────────────────────
SENTRY_DSN=https://key@sentry.io/project-id

# ── Frontend Portal URL ────────────────────────────────────────────────────────
FRONTEND_URL=https://portal.yourdomain.com

# ── Arkesel SMS Gateway (Ghana SMS OTP) ────────────────────────────────────────
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID=ASDAM
ARKESEL_SMS_URL=https://sms.arkesel.com/api/v2/sms/send
